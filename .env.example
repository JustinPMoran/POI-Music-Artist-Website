# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact form inquiries should be sent
RESEND_TO_EMAIL=pvmclasen@gmail.com

# Sender email address
# On Resend free tier without a verified domain, use: onboarding@resend.dev
# Once your domain is verified in Resend, use: POI Contact Form <inquiry@yourdomain.com>
RESEND_FROM_EMAIL=POI Contact Form <onboarding@resend.dev>
